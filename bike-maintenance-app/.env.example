# ==============================================================================
# MotoTrack AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.

# ------------------------------------------------------------------------------
# Supabase Configuration (Client-side - Safe to expose, protected by RLS)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# ------------------------------------------------------------------------------
# Supabase Server-Side Secrets (Used in Supabase Edge Functions ONLY)
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# ------------------------------------------------------------------------------
# Google OAuth (Configured in Supabase Dashboard)
# ------------------------------------------------------------------------------
# 1. Go to Supabase Dashboard → Authentication → Providers → Google
# 2. Enable Google OAuth and add your Google Cloud OAuth credentials:
#    - Google Client ID (e.g. 123456789-abcdef.apps.googleusercontent.com)
#    - Google Client Secret
# 3. Add Authorized Redirect URI: https://your-project-id.supabase.co/auth/v1/callback
# 4. For native app deep linking, add "mototrack://" to your Expo app.json extra
#    (handled automatically by Expo; no client-side env var needed)

# ------------------------------------------------------------------------------
# AI Provider Configuration (Server-Side in Supabase Edge Functions)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ------------------------------------------------------------------------------
# Monitoring & Telemetry (Client & Server)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ------------------------------------------------------------------------------
# Environment Flags
# ------------------------------------------------------------------------------
EXPO_PUBLIC_APP_ENV=development

# ------------------------------------------------------------------------------
# API Ninjas Motorcycles API (Client-side endpoint access)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_NINJA_API_KEY=your-api-ninjas-key-here
